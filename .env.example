# PostgreSQL
DOCKERHUB_USERNAME=your-dockerhub-username
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=kingwangjjang_dev
POSTGRES_USER=kingwangjjang
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://kingwangjjang:change-me@localhost:15432/kingwangjjang_dev
DOCKER_DATABASE_URL=postgresql+psycopg://kingwangjjang:change-me@kingwangjjang-postgres:5432/kingwangjjang_dev

# Runtime
SERVER_RUN_MODE=FALSE
ROOT=./media
# Base interval and protected-site overrides. Values must be integer minutes >= 1.
CRAWLER_INTERVAL_MINUTES=5
CRAWLER_ARCA_INTERVAL_MINUTES=10
CRAWLER_THEQOO_INTERVAL_MINUTES=15
CRAWLER_FMKOREA_INTERVAL_MINUTES=30
# Comma-separated temporary stop list.
CRAWLER_DISABLED_SITES=fmkorea,theqoo,arca
# Optional approved proxy for data-center IP blocks.
CRAWLER_HTTP_PROXY=
# Docker host directory shared by the crawler and API/image server.
CRAWLER_MEDIA_HOST_ROOT=/mnt/kingwangjjang

# Optional AI utilities
CHATGPT_API_KEY=

# Optional crawler media upload
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=

# Optional notifications
WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional OAuth/JWT utilities
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
JWT_SECRET_KEY=change-me-jwt-secret
